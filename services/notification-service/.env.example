# ── Notification Service ──────────────────────────────────────────────────────
PORT=3004
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paytech
POSTGRES_USER=paytech
POSTGRES_PASSWORD=changeme

PG_POOL_MAX=10

# RabbitMQ / AMQP
RABBITMQ_URL=amqp://paytech:changeme@localhost:5672/paytech

# Simulate random send failures for testing the idempotency / claimed-but-unsent scenario.
# Set to 0 in production. Range: 0.0 (never fail) – 1.0 (always fail).
SIMULATE_SEND_FAILURE=0
