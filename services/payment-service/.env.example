# ── Payment Service ───────────────────────────────────────────────────────────
PORT=3002
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paytech
POSTGRES_USER=paytech
POSTGRES_PASSWORD=changeme

PG_POOL_MAX=10

# RabbitMQ / AMQP
# GCP: use CloudAMQP or Google Cloud Pub/Sub bridge
#      RABBITMQ_URL=amqps://<user>:<pass>@<host>.cloudamqp.com/<vhost>
# AWS: Amazon MQ — use the amqps:// broker endpoint
RABBITMQ_URL=amqp://paytech:changeme@localhost:5672/paytech

# Internal service URLs
FRAUD_SERVICE_URL=http://localhost:3005
LEDGER_SERVICE_URL=http://localhost:3006

# Fraud fail-open policy
# false (default) — reject payment when fraud-service is unreachable (safest)
# true            — approve with decision=review when fraud-service is unreachable
FRAUD_FAIL_OPEN=false
