# ── User Service ──────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info

# PostgreSQL
# GCP: Cloud SQL — use Unix socket path via Cloud SQL Auth Proxy
#      POSTGRES_HOST=/cloudsql/<project>:<region>:<instance>
# AWS: RDS — use the RDS endpoint hostname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paytech
POSTGRES_USER=paytech
POSTGRES_PASSWORD=changeme          # inject from Secret Manager / Parameter Store

PG_POOL_MAX=10
