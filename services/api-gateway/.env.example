# ── API Gateway ───────────────────────────────────────────────────────────────
# Copy to .env for local development. Never commit .env to source control.
# In production inject these via Secret Manager (GCP) or Parameter Store (AWS).

PORT=3000
LOG_LEVEL=info                         # trace | debug | info | warn | error

# Downstream service URLs
# GCP Cloud Run: https://<service>-<hash>-<region>.a.run.app
# AWS ECS:       http://<service>.<namespace>.svc.cluster.local
USER_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Comma-separated API keys.
# In production use Secret Manager — never hardcode real keys here.
VALID_API_KEYS=test-key-alice,test-key-bob
